{
  "name": "is-even-decision",
  "version": "2.0.0",
  "description": "Check if a number is even using the power of a decision model. Drop-in for is-even-ai: no API key, no cloud, one forward pass.",
  "keywords": [
    "is-even",
    "is-odd",
    "is-even-ai",
    "even",
    "odd",
    "parity",
    "decision-model",
    "system-one",
    "laya",
    "jev",
    "ai",
    "machine-learning"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "jvlax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvlax/is-even-decision-model.git"
  },
  "homepage": "https://github.com/jvlax/is-even-decision-model#readme",
  "bugs": {
    "url": "https://github.com/jvlax/is-even-decision-model/issues"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/unit.test.js",
    "test:real": "IS_EVEN_REAL=1 node --test test/real.test.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@receptron/laya": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
